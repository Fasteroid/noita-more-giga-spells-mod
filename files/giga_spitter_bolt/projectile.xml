<Entity name="$projectile_default" tags="projectile_player">

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="0"
			air_friction="0"
			mass="0.06"
			>
		</VelocityComponent> 
	</Base>

	<ProjectileComponent 
		_enabled="1" 
		lob_min="0.8"
		lob_max="1"
		speed_min="90"
		speed_max="90"
		friction="0"
		direction_random_rad="0.00"
		on_death_explode="1"
		on_death_gfx_leave_sprite="0" 
		on_lifetime_out_explode="1"
		explosion_dont_damage_shooter="0"
		on_collision_die="0"
		lifetime="240"
		damage="0.0"
		bounce_always="1"
		bounces_left="10"
		bounce_energy="1"
		velocity_sets_scale="1"
		lifetime_randomness="7"
		ragdoll_force_multiplier="0.01"
		hit_particle_force_multiplier="0.1"
		velocity_sets_rotation="1"
		muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_small_pink.xml"
		shoot_light_flash_radius="90" 
		shoot_light_flash_r="245"
		shoot_light_flash_g="90"
		shoot_light_flash_b="220"
		knockback_force="1.0"
		physics_impulse_coeff="3500"
		friendly_fire="1"
		collide_with_shooter_frames="3"
		penetrate_world_velocity_coeff="1"
		penetrate_entities="1"
		penetrate_world="1"
	>
		<config_explosion
			never_cache="1" 
			damage="0.0"
			camera_shake="0" 
			explosion_radius="2" 
			explosion_sprite="data/particles/explosion_032_pink.xml" 
			explosion_sprite_lifetime="0.0" 
			explosion_sprite_lifetime="0" 
			create_cell_probability="0" 
			hole_destroy_liquid="0" 
			hole_enabled="0" 
			ray_energy="400000"
			particle_effect="0" 
			damage_mortals="1"
			physics_explosion_power.min="0" 
			physics_explosion_power.max="0" 
			physics_throw_enabled="0" 
			shake_vegetation="1" 
			sparks_enabled="0"  
			material_sparks_enabled="1"
			material_sparks_count_max="2"
			material_sparks_count_min="0" 
			light_enabled="0" 
			stains_enabled="1"
			stains_radius="3" >
		</config_explosion>
	</ProjectileComponent>

	<AreaDamageComponent
		_tags="area_damage"
		circle_radius="14"
		aabb_min.x="-14" 
		aabb_min.y="-14" 
		aabb_max.x="14" 
		aabb_max.y="14" 
		damage_per_frame="0.06"
		update_every_n_frame="1"
		entities_with_tag="hittable"
		damage_type="DAMAGE_PROJECTILE"
		_enabled="0"
		>
	</AreaDamageComponent>
	
	
	<SpriteComponent 
		_enabled="1" 
		alpha="1" 
		image_file="data/projectiles_gfx/orb_pink_big.xml" 
		next_rect_animation="" 
		offset_x="0" 
		offset_y="0" 
		rect_animation="spawn" 
		emissive="1"
		additive="1"

		update_transform_rotation="0"
	>
	</SpriteComponent>
	
	<LuaComponent 
		_enabled="1" 
		script_source_file="mods/more_giga_spells/files/giga_spitter_bolt/projectile.lua" 
		execute_every_n_frame="1"
		remove_after_executed="1"
		>
	</LuaComponent>

	<LuaComponent 
		_enabled="1" 
		script_source_file="mods/more_giga_spells/files/giga_spitter_bolt/damage.lua" 
		execute_every_n_frame="2"
		remove_after_executed="1"
		>
	</LuaComponent>

	<LightComponent 
		_enabled="1" 
		radius="150" 
		r="80"
		g="10"
		b="40"
	>
	</LightComponent>

	<ParticleEmitterComponent 
		emitted_material_name="fuse_bright"
		gravity.y="0"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="0"
		y_pos_offset_min="0"
		x_pos_offset_max="0"
		y_pos_offset_max="0"
		x_vel_min="-15"
		x_vel_max="15"
		y_vel_min="-15"
		y_vel_max="15"
		friction="1"
		count_min="2"
		count_max="3"
		area_circle_radius.max="7"
		area_circle_radius.min="7"
		lifetime_min="1.9"
		lifetime_max="2.1"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		emission_interval_min_frames="3"
		emission_interval_max_frames="3"
		delay_frames="3"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_laser">
	</AudioComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/more_giga_spells/files/giga_spitter_bolt/projectile.xml"
	>
	</VariableStorageComponent>

</Entity>


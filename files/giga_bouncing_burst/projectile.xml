<Entity tags="hittable,teleportable_NOT,mortal,item_physics,projectile" >

	<!-- physical presence -->
	
	<PhysicsBodyComponent 
		_tags="enabled_in_world"
		uid="1" 
		allow_sleep="1" 
		angular_damping="0" 
		fixed_rotation="0" 
		is_bullet="1" 
		linear_damping="0"
		auto_clean="1"
		on_death_leave_physics_body="0"
	>
	</PhysicsBodyComponent>
	
	<PhysicsImageShapeComponent 
		body_id="1"
		centered="1"
		image_file="mods/more_giga_spells/files/giga_bouncing_burst/spell.png"
		material="giga_bouncy_box2d"
	>
	</PhysicsImageShapeComponent>

	<ProjectileComponent
		_tags="enabled_in_world"
		_enabled="1"
		lifetime="1000"
		penetrate_entities="1"
		damage="0.0"
		do_moveto_update="1"
		lob_min="0.5"
		lob_max="0.7"
		speed_min="650"
		speed_max="750"
	    on_death_explode="1"
		on_death_gfx_leave_sprite="0"
		shoot_light_flash_r="255"
		shoot_light_flash_g="210"
		shoot_light_flash_b="70"
	    shoot_light_flash_radius="120"
		on_lifetime_out_explode="1"
		explosion_dont_damage_shooter="1"
	>
		<config_explosion
			damage="0"
			explosion_radius="0"
		>
		</config_explosion>
	</ProjectileComponent>

	<VelocityComponent
		_tags="enabled_in_world"
		affect_physics_bodies="1"
	>
	</VelocityComponent>

	<!-- item -->
	
	<ExplodeOnDamageComponent
		explode_on_death_percent="1"
		explode_on_damage_percent="0.0"
		physics_body_modified_death_probability="0.9"
		physics_body_destruction_required="0.8"
		>
		<config_explosion
			never_cache="0"
			damage="0"
			camera_shake="0" 
			explosion_radius="0" 
			explosion_sprite="" 
			explosion_sprite_lifetime="0" 
			create_cell_probability="0" 
			hole_destroy_liquid="0" 
			hole_enabled="0" 
			ray_energy="0"
			particle_effect="0" 
			damage_mortals="0" 
			physics_throw_enabled="0"
			shake_vegetation="0" 
			sparks_enabled="0" 
			stains_enabled="0" 
			>
		</config_explosion>
	</ExplodeOnDamageComponent>

	<ParticleEmitterComponent 
		emitted_material_name="plasma_fading_green"
		offset.x="0"
		offset.y="0"
		area_circle_radius.min="6"
		area_circle_radius.max="6.5"
		gravity.y="0"
		x_vel_min="-3"
		x_vel_max="3"
		y_vel_min="-3"
		y_vel_max="3"
		count_min="1"
		count_max="1"
		lifetime_min="0.2"
		lifetime_max="0.3"
		airflow_force="1.0"
		airflow_time="0.401"
		airflow_scale="0.25"
		is_trail="1"
		trail_gap="0.8"
		create_real_particles="0"
		emit_cosmetic_particles="1"
		render_on_grid="1"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		fade_based_on_lifetime="1"
		is_emitting="1"
		velocity_always_away_from_center="-20"
	>
	</ParticleEmitterComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="projectiles/orb_cursed" >
	</AudioComponent>

	<AudioComponent
		file="data/audio/Desktop/projectiles.bank"
		event_root="player_projectiles/bullet_rubber_ball" >
	</AudioComponent>
	
	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/more_giga_spells/files/giga_bouncing_burst/projectile.xml"
	>
	</VariableStorageComponent>

	<LuaComponent 
		_enabled="1" 
		script_source_file="mods/more_giga_spells/files/giga_bouncing_burst/projectile.lua" 
		execute_every_n_frame="1"
		remove_after_executed="1"
		>
	</LuaComponent>

	<LuaComponent 
		_enabled="1" 
		script_source_file="mods/more_giga_spells/files/giga_bouncing_burst/damage.lua" 
		execute_every_n_frame="1"
		>
	</LuaComponent>

	<!-- ゴゴゴゴ -->
	<MusicEnergyAffectorComponent
		energy_target="1.0"
	>
  	</MusicEnergyAffectorComponent>

</Entity>
